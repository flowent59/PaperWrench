# PaperWrench configuration.
#
# Copy to .env and adjust. Every value can also be supplied as a plain
# environment variable; .env is only a convenience for docker compose.
#
# SECURITY: the Paperless token is a full-access credential for your document
# library. PaperWrench keeps it in the backend process only - it is never
# written to the database, never logged, and never sent to the browser.

# ---------------------------------------------------------------------------
# Paperless-ngx connection (required)
# ---------------------------------------------------------------------------

# Base URL of YOUR existing Paperless-ngx instance, without a trailing slash.
PAPERLESS_URL=https://paperless.example.lan

# API token: Paperless-ngx > Settings > My Profile > API Auth Token.
# Prefer PAPERLESS_TOKEN_FILE below if you use Docker secrets.
PAPERLESS_TOKEN=

# Path to a file containing the token. Takes precedence over PAPERLESS_TOKEN.
# PAPERLESS_TOKEN_FILE=/run/secrets/paperless_token

# REST API version to negotiate explicitly via the Accept header.
# Verified against Paperless-ngx 3.1.2 (ALLOWED_VERSIONS ["9","10"]).
# Do not change unless you know your server rejects version 10.
PAPERLESS_API_VERSION=10

# Seconds before an HTTP call to Paperless is abandoned.
PAPERLESS_TIMEOUT=30

# Verify the Paperless TLS certificate. Only disable for a self-signed
# certificate on a trusted LAN, and understand that you lose MITM protection.
PAPERLESS_VERIFY_SSL=true

# ---------------------------------------------------------------------------
# PaperWrench runtime
# ---------------------------------------------------------------------------

# Where jobs, operations and history live. BACK THIS UP: it is what makes a
# rollback possible after a bulk write.
PAPERWRENCH_DATABASE_URL=sqlite+pysqlite:////data/paperwrench.db

PAPERWRENCH_HOST=0.0.0.0
PAPERWRENCH_PORT=8000

# DEBUG | INFO | WARNING | ERROR
PAPERWRENCH_LOG_LEVEL=INFO
# json (production) | console (development)
PAPERWRENCH_LOG_FORMAT=json

# Simultaneous in-flight writes to Paperless. Higher is not better: it is your
# Paperless instance that pays. Hard ceiling: 16.
PAPERWRENCH_MAX_CONCURRENCY=4

# Page size used when listing documents from Paperless (server maximum applies).
PAPERWRENCH_DEFAULT_PAGE_SIZE=100

# ---------------------------------------------------------------------------
# Development only
# ---------------------------------------------------------------------------

# Comma-separated origins allowed to call the API cross-origin. MUST stay
# empty in production: the SPA is served from the same origin as the API.
# PAPERWRENCH_CORS_ORIGINS=http://localhost:5173

# Directory holding a built SPA. Defaults to the copy packaged in the wheel.
# PAPERWRENCH_STATIC_DIR=/app/static
